# Copy to .env and adjust. The same variables are read by the local dev server,
# the test suite and the Docker deployment — only the values differ.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
# Generate one for any real deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=insecure-dev-key-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Local development uses the Postgres already installed on your machine.
# Create it once with:  createdb expense_analyser
DATABASE_URL=postgres://localhost:5432/expense_analyser
TEST_DATABASE_URL=postgres://localhost:5432/expense_analyser_test

# --- Application ----------------------------------------------------------
DEFAULT_CURRENCY=INR

# --- Optional AI categorisation -------------------------------------------
# Entirely optional. The rules engine works fully offline without any of this.
# Enabling it sends transaction descriptions to a third-party API — see
# docs/faq.md before turning it on.
ENRICHMENT_BACKEND=null
# ANTHROPIC_API_KEY=
# ENRICHMENT_MODEL=claude-opus-5
