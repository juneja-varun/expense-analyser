# Builds the API and serves the compiled SPA from the same origin, so session
# cookies behave in production exactly as they do behind the Vite dev proxy.

# --- Stage 1: build the frontend bundle -------------------------------------
FROM node:20-slim AS frontend

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- Stage 2: Python runtime ------------------------------------------------
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first so edits to application code don't invalidate this layer.
COPY backend/pyproject.toml backend/poetry.lock ./
RUN pip install poetry==2.1.3 \
    && poetry config virtualenvs.create false \
    && poetry install --without dev --no-interaction --no-root

COPY backend/ ./

# The SPA is served as static files by whitenoise.
COPY --from=frontend /build/dist ./frontend_dist

RUN python manage.py collectstatic --noinput \
    || echo "collectstatic deferred to entrypoint"

RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -fsS http://localhost:8000/api/health/ || exit 1

COPY --chown=app:app deploy/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
